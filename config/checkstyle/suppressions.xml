<?xml version="1.0"?>

<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<suppressions>
    <!-- Test values are examples and expected results; named constants would obscure them. -->
    <suppress checks="MagicNumber" files=".*[\\/]src[\\/](test|testFixtures)[\\/].*"/>
    <!-- Test suites may have many cases or branching fixtures by design. -->
    <suppress checks="MethodCount|NPathComplexity" files=".*[\\/]src[\\/]test[\\/].*"/>
    <!-- RaftNodeImpl centralizes the node protocol and intentionally exceeds generic size/coupling limits. -->
    <suppress checks="FileLength|ClassDataAbstractionCoupling|ClassFanOutComplexity|MethodCount|ParameterNumber"
              files=".*[\\/]RaftNodeImpl[.]java"/>
    <!-- This constructor models a full immutable Raft report snapshot. -->
    <suppress checks="ParameterNumber" files=".*[\\/]RaftNodeReportImpl[.]java"/>
    <!-- The model factory necessarily instantiates the concrete implementation of each model type. -->
    <suppress checks="ClassDataAbstractionCoupling" files=".*[\\/]DefaultRaftModelFactory[.]java"/>
    <!-- Membership change dispatch has explicit validation branches for each operation mode. -->
    <suppress checks="ReturnCount|CyclomaticComplexity" files=".*[\\/]MembershipChangeTask[.]java"/>
</suppressions>
